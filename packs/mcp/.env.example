# MCP連携用の環境変数。.env.local にコピーして実値を入れる。
# .gitignore に .env.local を含める（このキットの.gitignoreは設定済）。

# ---- GitHub ----
# https://github.com/settings/tokens で fine-grained PAT 作成
# 必要権限: repo (read+write), pull_requests, issues, contents
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxx

# ---- Slack ----
# Slack App作成: https://api.slack.com/apps
# OAuth Scopes: channels:history, channels:read, chat:write, users:read
SLACK_BOT_TOKEN=xoxb-xxx
SLACK_TEAM_ID=T0XXXXXXX
SLACK_CHANNEL_IDS=C0XXXXX,C0YYYYY

# ---- AWS Bedrock ----
# aws sso login または aws configure 済の前提
AWS_PROFILE=default
AWS_REGION=ap-northeast-1

# ---- Dify ----
# Dify管理画面 > APIキー
DIFY_API_KEY=app-xxx
DIFY_BASE_URL=https://api.dify.ai/v1
# Self-hosted の場合: https://dify.your-domain.com/v1

# ---- Postgres (read-only) ----
# 本番DBは絶対に書かない。read-onlyロール作成必須:
#   CREATE ROLE mcp_ro WITH LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE mydb TO mcp_ro;
#   GRANT USAGE ON SCHEMA public TO mcp_ro;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO mcp_ro;
POSTGRES_DEV_RO_URL=postgresql://mcp_ro:password@localhost:5432/mydb

# ---- マルチLLM並走（後述pack）----
ANTHROPIC_API_KEY=sk-ant-xxx
GEMINI_API_KEY=AIzaSy-xxx
OPENAI_API_KEY=sk-xxx
